{% import 'components/form/fields_macros.html.twig' as fields %}
<div id="itcore-dock-settings">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="fs-4 m-0">Док-станции - настройки</h1>
    <a class="btn btn-outline-secondary btn-sm" href="{{ migration_url }}"><i class="ti ti-arrows-exchange me-1" aria-hidden="true"></i>Перенос устройств</a>
  </div>
  {% if message %}<div class="alert alert-success">{{ message }}</div>{% endif %}
  {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
  <form method="post" id="dock-profiles-form">
    <input type="hidden" name="_glpi_csrf_token" value="{{ glpi_csrf }}">
    <input type="hidden" name="_itcore_csrf" value="{{ csrf }}">
    <input type="hidden" name="revision" value="{{ revision }}">
    <input type="hidden" name="active_tab" id="dock-active-tab" value="{{ active }}">
    <input type="hidden" name="selected_vendor" id="dock-selected-vendor" value="{{ vendor }}">
    <input type="hidden" name="restore_id" id="dock-restore-id">
    <textarea hidden id="dock-settings-json" name="settings_json">{{ settings|json_encode }}</textarea>
    <textarea hidden id="dock-import-json" name="import_json">{{ import_json }}</textarea>
    <div class="d-flex card-tabs flex-column flex-md-row vertical">
      <ul id="tabspanel" class="nav nav-tabs flex-row flex-md-column d-none d-md-block" role="tablist" aria-label="Настройки док-станций" style="min-width:200px">
        {% for id, tab in tabs %}
          <li class="nav-item ms-0" role="presentation"><a class="nav-link justify-content-between pe-1{{ active == id ? ' active' : '' }}" href="#dock-panel-{{ id }}" data-dock-tab="{{ id }}" role="tab" aria-controls="dock-panel-{{ id }}" aria-selected="{{ active == id ? 'true' : 'false' }}"><span class="d-flex align-items-center"><i class="ti {{ tab.icon }} me-2" aria-hidden="true"></i>{{ tab.label }}</span></a></li>
        {% endfor %}
      </ul>
      <select id="dock-mobile-tab" class="form-select border-2 rounded-0 rounded-top d-md-none mb-2" aria-label="Раздел настроек">{% for id, tab in tabs %}<option value="{{ id }}"{{ active == id ? ' selected' : '' }}>{{ tab.label }}</option>{% endfor %}</select>
      <div class="tab-content p-2 flex-grow-1 card border-start-0">
      <div class="card-body">

        <div id="dock-context" class="dock-context mb-4" hidden><label class="form-label mb-0" for="dock-vendor-select">Производитель</label><select class="form-select" id="dock-vendor-select"></select><span class="text-muted" id="dock-vendor-status"></span></div>
        <section id="dock-panel-general" role="tabpanel" data-dock-panel="general">
          <div class="row flex-row">
          {% for key, label in {'enabled':'Распознавать док-станции','migrate_existing':'Переносить существующие устройства','dock_location':'Пользователь и местоположение по ПК','add_marker':'Технический USB-маркер в комментарии'} %}
            {{ fields.dropdownArrayField('dock_global_' ~ key, settings[key] ? 1 : 0, {0:'Нет',1:'Да'}, label, {'width':'65px', 'specific_tags':{'data-global':key,'data-kind':'bool'}}) }}
          {% endfor %}
          {{ fields.textField('dock_global_type_name', settings.type_name, 'Тип док-станции', {'id':'dock-global-type-name', 'additional_attributes':{'data-global':'type_name'}}) }}
          </div>
          <div class="text-muted mt-3">Ручные блокировки GLPI учитываются. Удаление настроек не удаляет оборудование.</div>
        </section>
        <section id="dock-panel-vendors" role="tabpanel" data-dock-panel="vendors" hidden><div class="dock-toolbar mb-3"><h3 class="card-subtitle mb-0">Производители</h3><button type="button" class="btn btn-outline-secondary" id="dock-add-vendor"><i class="ti ti-plus me-1"></i>Добавить производителя</button></div><div id="dock-vendors-list" class="card dock-list-container">{{ include('components/datatable.html.twig', {'datatable_id':'dock-vendors-table','datatable_aria_label':'vendors','columns':{'name':'Наименование','vids':'USB VID','enabled':'Включён','counts':'Модели / правила'},'entries':[],'total_number':1,'nosort':true,'nofilter':true,'use_pager':false}) }}</div><p class="text-muted mt-3">В поставке настроен Lenovo. Других производителей можно добавить вручную; совместимость не гарантируется.</p>
          <div id="dock-vendor-editor" class="dock-editor" hidden><h3 class="card-subtitle mb-3">Настройки производителя</h3><div class="row flex-row"><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-vendor-name">Название</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-vendor-name" maxlength="255"></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-vendor-vids">VID через запятую</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-vendor-vids" placeholder="17EF"></div></div><label class="form-check form-switch"><input type="checkbox" class="form-check-input" id="dock-vendor-enabled"><span class="form-check-label">Распознавание включено</span></label></div><div class="dock-buttons mt-3"><button type="button" class="btn btn-primary" id="dock-vendor-apply">Применить к форме</button><button type="button" class="btn btn-outline-secondary" data-close="dock-vendor-editor">Отмена</button></div><p class="text-danger mt-2" id="dock-vendor-error" role="alert"></p></div>
        </section>
        <section id="dock-panel-models" role="tabpanel" data-dock-panel="models" hidden><div class="dock-toolbar mb-3"><h3 class="card-subtitle mb-0">Модели и PID</h3><button type="button" class="btn btn-outline-secondary" id="dock-add-model">Добавить модель</button></div><div id="dock-models-list" class="card dock-list-container">{{ include('components/datatable.html.twig', {'datatable_id':'dock-models-table','datatable_aria_label':'models','columns':{'name':'Наименование','code':'Модель','pids':'PID','enabled':'Включена'},'entries':[],'total_number':1,'nosort':true,'nofilter':true,'use_pager':false}) }}</div><p class="text-muted" id="dock-model-empty" hidden>Добавьте модель и её PID.</p>
          <div id="dock-model-editor" class="dock-editor" hidden><h3 class="card-subtitle mb-3">Настройки модели</h3><div class="row flex-row"><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-model-code">Код модели</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-model-code" maxlength="64"></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-model-pids">PID через запятую</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-model-pids" placeholder="30A9, 3105"></div></div><div class="form-field row align-items-center col-12 glpi-full-width mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-model-name">Название в GLPI</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-model-name" maxlength="255"></div></div><label class="form-check form-switch"><input type="checkbox" class="form-check-input" id="dock-model-enabled"><span class="form-check-label">Модель включена</span></label></div><div class="dock-buttons mt-3"><button type="button" class="btn btn-primary" id="dock-model-apply">Применить к форме</button><button type="button" class="btn btn-outline-secondary" data-close="dock-model-editor">Отмена</button></div><p class="text-danger mt-2" id="dock-model-error" role="alert"></p></div>
        </section>
        <section id="dock-panel-rules" role="tabpanel" data-dock-panel="rules" hidden><div class="dock-toolbar mb-3"><h3 class="card-subtitle mb-0">Правила обработки</h3><button type="button" class="btn btn-outline-secondary" id="dock-add-rule">Добавить правило</button></div><p class="text-muted mb-3">Проверяются сверху вниз. Первое совпавшее правило определяет результат; неизвестный номер сохраняется без изменений.</p><div id="dock-rules-list" class="card dock-list-container">{{ include('components/datatable.html.twig', {'datatable_id':'dock-rules-table','datatable_aria_label':'rules','columns':{'name':'Наименование','scope':'Модели','enabled':'Включено','position':'Порядок обработки'},'entries':[],'total_number':1,'nosort':true,'nofilter':true,'use_pager':false}) }}</div><p class="text-muted" id="dock-rule-empty" hidden>Правил нет - исходные номера сохраняются.</p>
          <div id="dock-rule-editor" class="dock-editor" hidden><h3 class="card-subtitle mb-3">Настройки правила</h3><div class="row flex-row"><div class="form-field row align-items-center col-12 glpi-full-width mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-name">Название</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-rule-name" maxlength="255"></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-models">Модели (без выбора - все)</label><div class="col-xxl-7 field-container"><select class="form-select" id="dock-rule-models" multiple size="3"></select></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-pids">Только PID через запятую</label><div class="col-xxl-7 field-container"><input class="form-control" id="dock-rule-pids" placeholder="Пусто - все PID моделей"></div></div><div class="form-field row align-items-center col-12 glpi-full-width mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-action">Действие</label><div class="col-xxl-7 field-container"><select class="form-select" id="dock-rule-action"><option value="extract">Извлечь по выражению</option><option value="keep">Сохранить исходный номер</option></select></div></div></div>
            <div id="dock-regex-fields" class="row flex-row mt-3"><div class="form-field row align-items-center col-12 glpi-full-width mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-pattern">Выражение</label><div class="col-xxl-7 field-container"><input class="form-control font-monospace" id="dock-rule-pattern" maxlength="1000"></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-serial">Группа серийного номера</label><div class="col-xxl-7 field-container"><input type="number" min="1" max="9" class="form-control" id="dock-rule-serial"></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-rule-extra">Дополнительное значение</label><div class="col-xxl-7 field-container"><select class="form-select" id="dock-rule-extra"><option value="none">Не извлекать</option><option value="model">Код модели</option><option value="part">Номер детали / Part Number</option></select></div></div><label class="form-label" id="dock-extra-group-label">Группа дополнительного значения<input type="number" min="1" max="9" class="form-control mt-2" id="dock-rule-extra-group"></label><label class="form-check form-switch" id="dock-check-model-label"><input type="checkbox" class="form-check-input" id="dock-rule-check-model"><span class="form-check-label">Проверять четырёхсимвольный код модели</span></label></div>
            <div class="dock-buttons mt-3"><button type="button" class="btn btn-primary" id="dock-rule-apply">Применить к списку</button><button type="button" class="btn btn-outline-secondary" data-close="dock-rule-editor">Отмена</button></div><p class="text-danger mt-2" id="dock-rule-error" role="alert"></p>
          </div>
        </section>
        <section id="dock-panel-preview" role="tabpanel" data-dock-panel="preview" hidden><h3 class="card-subtitle mb-3">Проверка без изменения карточек</h3><div class="row flex-row"><div class="form-field row align-items-center col-12 glpi-full-width mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-test-rule">Правило</label><div class="col-xxl-7 field-container"><select class="form-select" name="preview[rule]" id="dock-test-rule" data-current="{{ test.rule }}"></select></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-test-vid">VID</label><div class="col-xxl-7 field-container"><input class="form-control" name="preview[vid]" id="dock-test-vid" value="{{ test.vid }}" maxlength="4"></div></div><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-test-pid">PID</label><div class="col-xxl-7 field-container"><input class="form-control" name="preview[pid]" id="dock-test-pid" value="{{ test.pid }}" maxlength="4"></div></div><div class="form-field row align-items-center col-12 glpi-full-width mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-test-serial">Исходный серийный номер</label><div class="col-xxl-7 field-container"><input class="form-control font-monospace" name="preview[serial]" id="dock-test-serial" value="{{ test.serial }}" maxlength="255"></div></div></div><div class="dock-buttons mt-3"><button type="submit" name="action" value="preview" class="btn btn-primary">Проверить</button><label class="form-label mb-0" for="dock-example">Заполнить пример</label><select class="form-select" id="dock-example"><option value="">Выбрать…</option><option value="short">Lenovo: короткий составной номер</option><option value="long">Lenovo: длинный составной номер</option><option value="plain">Lenovo: заводской номер</option></select></div>
          {% if preview is same as(false) %}<div class="alert alert-warning mt-3">Не распознано. Проверьте включение профиля, VID, PID и серийный номер.</div>{% elseif preview is not null %}<dl class="dock-result mt-4"><dt>Производитель</dt><dd>{{ preview.manufacturer }}</dd><dt>Модель</dt><dd>{{ preview.name }} ({{ preview.model }})</dd><dt>Исходный номер</dt><dd>{{ preview.raw }}</dd><dt>Сработало правило</dt><dd>{{ preview.rule_name ?: 'Нет совпадения' }}</dd><dt>Серийный номер</dt><dd>{{ preview.serial }}</dd>{% if preview.part %}<dt>{{ preview.extra_kind == 'model' ? 'Код модели' : 'Номер детали' }}</dt><dd>{{ preview.part }}</dd>{% endif %}<dt>Результат</dt><dd>{{ preview.serial_status }}</dd></dl>{% endif %}
        </section>
        <section id="dock-panel-presets" role="tabpanel" data-dock-panel="presets" hidden><h3 class="card-subtitle mb-3">Импорт и экспорт</h3><h4>Экспорт настроек</h4><p class="text-muted mb-3">Только настройки. Карточки оборудования, пользователи, история и внутренние ID GLPI не выгружаются.</p><div class="dock-buttons"><select class="form-select" name="export_scope"><option value="vendor">Выбранный производитель</option><option value="all">Все настройки</option></select><button type="submit" name="action" value="export" class="btn btn-outline-secondary">Экспортировать JSON</button></div><hr class="my-4"><h4>Импорт настроек</h4><p class="text-muted">Файл сначала проверяется. После загрузки в форму изменения нужно сохранить отдельно.</p><div class="form-field row align-items-center col-12 col-sm-6 mb-2"><label class="col-form-label col-xxl-5 text-xxl-end" for="dock-preset-file">JSON-файл</label><div class="col-xxl-7 field-container"><input id="dock-preset-file" type="file" class="form-control" accept=".json,application/json"></div></div><p class="text-danger" id="dock-file-error" role="alert"></p><button type="submit" name="action" value="import_preview" class="btn btn-outline-secondary mt-2">Проверить файл</button>
          {% if import_preview is not null %}<div class="table-responsive mt-4"><table class="table"><thead><tr><th>Производитель</th><th>Действие</th><th>Модели</th><th>Правила</th></tr></thead><tbody>{% for row in import_preview %}<tr><td>{{ row.name }}</td><td>{{ row.replace ? 'Заменить профиль' : 'Добавить профиль' }}</td><td>{{ row.models }}</td><td>{{ row.rules }}</td></tr>{% endfor %}</tbody></table></div><p class="text-muted">Одноимённые профили заменяются целиком. Остальные производители сохраняются.</p><button type="submit" name="action" value="import_apply" class="btn btn-primary">Загрузить в форму</button>{% endif %}
        </section>
        <section id="dock-panel-history" role="tabpanel" data-dock-panel="history" hidden><h3 class="card-subtitle mb-3">История настроек</h3><div class="table-responsive"><table class="table"><thead><tr><th>Дата</th><th>Пользователь</th><th></th></tr></thead><tbody>{% for entry in history %}<tr><td>{{ entry.date }}</td><td>{{ entry.user_label }}</td><td><button type="submit" name="action" value="restore" class="btn btn-outline-secondary btn-sm" data-restore-id="{{ entry.id }}">Загрузить в форму</button></td></tr>{% else %}<tr><td colspan="3">Предыдущих редакций пока нет.</td></tr>{% endfor %}</tbody></table></div></section>
        <div class="card-footer d-flex align-items-center justify-content-between mt-3 px-0"><span class="text-muted" id="dock-dirty">{{ dirty ? 'Изменения в форме ещё не сохранены' : 'Нет несохранённых изменений' }}</span><button type="submit" name="action" value="save" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Сохранить</button></div>
      </div>
    </div></div></div>
  </form>
</div>
